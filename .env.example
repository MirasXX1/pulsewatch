# Local development examples only. Replace credentials for any deployment.
# .env is ignored by Git; do not put real secrets in this template.
POSTGRES_PORT=5433
POSTGRES_DB=pulsewatch
POSTGRES_USER=pulsewatch
POSTGRES_PASSWORD=local-development-only
DB_URL=jdbc:postgresql://127.0.0.1:5433/pulsewatch
DB_USERNAME=pulsewatch
DB_PASSWORD=local-development-only
BACKEND_URL=http://127.0.0.1:8080
